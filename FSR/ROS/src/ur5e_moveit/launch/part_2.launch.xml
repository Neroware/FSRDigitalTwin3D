<launch>
    <arg name="tcp_ip" default="0.0.0.0"/>
    <arg name="tcp_port" default="9090"/>
	
    <node name="server_endpoint" pkg="ros_tcp_endpoint" exec="default_server_endpoint" args="--wait" output="screen" respawn="true">
		<param name="ROS_IP" value="$(var tcp_ip)"/>
        <param name="ROS_TCP_PORT" value="$(var tcp_port)"/>
	</node>
    <node name="trajectory_subscriber" pkg="ur5e_moveit_py" exec="trajectory_subscriber" args="--wait" output="screen"/>
</launch>