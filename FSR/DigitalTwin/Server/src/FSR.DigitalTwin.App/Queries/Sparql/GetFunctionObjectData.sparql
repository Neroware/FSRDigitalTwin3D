PREFIX so: <http://schema.org/>
PREFIX ex: <http://www.example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX DUL: <http://www.loa-cnr.it/ontologies/DUL.owl#>
PREFIX ssn: <http://purl.oclc.org/NET/ssnx/ssn#>
PREFIX soho: <http://pst.istc.cnr.it/ontologies/2019/01/soho#>
PREFIX sobots: <https://www.forsocialrobots.de/ontologies/sobots.owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX pi: <https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi#>

SELECT DISTINCT ?target ?startLoc ?endLoc ?loc
WHERE {
    pi:tmp0 a soho:ProductionTask .
    OPTIONAL { pi:tmp0 soho:hasTarget ?target . }
  	OPTIONAL { pi:tmp0 soho:requiresStartLocation ?startLoc . }
  	OPTIONAL { pi:tmp0 soho:requiresEndLocation ?endLoc . }
  	OPTIONAL { pi:tmp0 soho:requiresLocation ?loc . }
}