    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Art -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Art">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ArtificalEmotionExpression -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ArtificalEmotionExpression">
