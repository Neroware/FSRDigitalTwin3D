    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ArtificalEmotionSimulation -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ArtificalEmotionSimulation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ArtisticCoCreation -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ArtisticCoCreation">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AuditiveHint -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AuditiveHint">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomyLevel -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#AutonomyLevel">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Amount"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Belief -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Children -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Children">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgeGroup"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Close -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Close">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveAdaptability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CognitiveTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeAssistance -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeAssistance">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeDivisionOfLabor -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CollaborativeDivisionOfLabor">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationProperty">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Communication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability"/>
        <rdfs:comment>A complex social capability discovered in the literature review on imprecise fuzzy techniques in social robotics conducted by the Chair of Digital Manufacturing at the University of Augsburg (https://github.com/Neroware/CPSL2026-Reproduce-SLR). 
These classes are essentially a subset of a top layer in a taxonomy tree on social robot capability.</rdfs:comment>
        <rdfs:label>Complex Social Capability</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ConcreteSocialCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A concrete social capability is part of some form of complex social capability and represents a certain aspect of said capability. 
E.g.: A robot&apos;s capability to adjust the speaking style depending on the role of the person it communicates with is a concrete social capability and a part of the complex social capability of Social-Cognitive Communication.</rdfs:comment>
        <rdfs:label>Concrete Social Capability</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ContinousTimeWindow">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#CrawlingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Days -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Days">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DecisionProcess">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isPreconditionEventOf"/>
                <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Desire -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isConstituentOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A device primitive is a low-level, hardware-related action that directly controls a device (robot arm, gripper, sensor) and has no semantic significance at the task level. A skill can be constituted of multiple primitives.
E.g.: A robot&apos;s Pick-and-Place skill has the two device primitives for Opening and Closing the gripper as constituents.</rdfs:comment>
        <rdfs:label>Device Primitive</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#hasTrigger"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#realizedIn"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
                            <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Quality"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#DispositionalBelief -->

