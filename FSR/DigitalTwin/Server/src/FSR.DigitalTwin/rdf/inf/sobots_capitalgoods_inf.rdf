                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#HumanFunction"/>
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotFunction"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#HRCTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


