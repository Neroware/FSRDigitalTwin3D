    <!-- http://pst.istc.cnr.it/ontologies/2019/01/soho#Assembly -->

    <owl:Class rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Assembly">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Join"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#requiresLocation"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#ProductionLocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


