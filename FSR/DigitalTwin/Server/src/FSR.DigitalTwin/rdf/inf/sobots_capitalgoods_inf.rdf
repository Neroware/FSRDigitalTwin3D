    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Service -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Service">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ApplicationArea"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ServiceRobot -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ServiceRobot">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotType"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ShortDuration -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortDuration">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ShortTerm">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame"/>
        <rdfs:comment>An interaction time frame between seconds and days.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SingleInteraction -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SingleInteraction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Skill -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Description"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Method"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#DevicePrimitive"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A skill describes an agent&apos;s capability by implementing a Method.
E.g.: A robot can have the capability to move objects, described by a skill &quot;Pick-and-Place&quot;, which implements the Function &quot;PickPlace&quot;.</rdfs:comment>
        <rdfs:label>Skill</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveAdmittanceControl -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveAdmittanceControl">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveCommunication -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveCommunication">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveMovement -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitiveMovement">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitivePositioning -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCognitivePositioning">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialDistance -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialDistance">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialFunction -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialFunction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#implements"/>
                        <owl:allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#Function"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Method"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialPlan -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialPlan">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Plan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <owl:allValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasComponent"/>
                <owl:allValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#SocialGoal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <owl:allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialProxemicZone -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialProxemicZone">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProxemicZone"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AutonomousRobot"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialAgent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#hasCapability"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#hasEmbodiment"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasQuality"/>
                <owl:someValuesFrom rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#RobotAutonomy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotAttribute">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isRegionFor"/>
                <owl:allValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotContext">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Situation"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotProperty -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobotProperty">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialRobot"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RobotProperty"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialSkill">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Skill"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#describes"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialCapability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A social skill describes some form of social capability.</rdfs:comment>
        <rdfs:label>Social Skill</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTask">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialMethod"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute"/>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SocioCulturalAdaptability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SocioCulturalAdaptability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AgentAdaptability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Stationary -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Stationary">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityLevel"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SuperficialAdaptations -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SuperficialAdaptations">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AdaptivityLevel"/>
        <rdfs:comment>Rare or superficial adaptation (e.g., simple parameter changes)</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#SwimmingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SwimmingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TechnicalSystem -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TechnicalSystem">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionPartner"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeDuration">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
        <rdfs:comment>Represents the duration of any event as a fixed time interval. Example: It took me 8 years to graduate from grammar school.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TimeFrame">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval"/>
        <rdfs:comment>A time frame one or multiple events can occur in. Example: During the recent three years this person visited me twice.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Touching -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Touching">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#TransportTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#TransportTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Trigger">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#isTriggerOf"/>
                <owl:someValuesFrom rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Disposition"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VerbalCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ReceiveCapabilitiy"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SendCapability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#VisualHint -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#VisualHint">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#WalkingCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#WalkingCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MobilityCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Weeks -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Weeks">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#MediumTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Workers -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Workers">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TargetGroup"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Years -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Years">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#LongTerm"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Zoomorph -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Zoomorph">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalLikeness"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi#action -->

    <owl:NamedIndividual rdf:about="https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi#action">
        <rdf:type rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Action"/>
        <rdf:type rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Entity"/>
        <rdf:type rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Event"/>
        <rdf:type rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Realization"/>
        <rdf:type rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SocialAction"/>
        <DUL:directlyFollows rdf:resource="https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi#decision-process"/>
        <DUL:follows rdf:resource="https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi#decision-process"/>
