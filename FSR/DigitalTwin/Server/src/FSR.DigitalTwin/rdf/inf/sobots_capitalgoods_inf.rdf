                                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief"/>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
