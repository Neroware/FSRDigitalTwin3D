        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#RatioRegion"/>
        <rdfs:comment>The amount of ocurred social interactions per day</rdfs:comment>
    </owl:Class>
    


