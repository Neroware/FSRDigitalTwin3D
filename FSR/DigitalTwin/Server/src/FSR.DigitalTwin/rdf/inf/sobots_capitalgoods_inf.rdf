                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#InteractionModality"/>
                            <rdf:Description rdf:about="http://pst.istc.cnr.it/ontologies/2019/01/soho#OperativeConstraint"/>
