        <rdfs:comment>Responds to user preferences and situational changes with some flexibility</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#FullyProactive">
