    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NaturalRobot -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NaturalRobot">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAgent"/>
        <rdfs:comment>&quot;A robot is a reprogrammable, multifunctional manipulator designed to move material, parts, tools or specialized devices through variable programmed motions for the performance of a variety of tasks&quot; -Robotic Industries Association</rdfs:comment>
        <rdfs:label>Natural robot</rdfs:label>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NoResemblance -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NoResemblance">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#AnimalLikeness"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#HumanLikeness"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#NonverbalCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ReceiveCapabilitiy"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SendCapability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Notify -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Notify">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#SendExtraverbal"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccasionalInteraction -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccasionalInteraction">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#InteractionAmount"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentBelief">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Belief"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#OccurentDesire">
        <rdfs:subClassOf rdf:resource="http://pst.istc.cnr.it/ontologies/2019/01/soho#CognitiveProcess"/>
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#Desire"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCapability -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ParaverbalCapability">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#CommunicationCapability"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#ReceiveCapabilitiy"/>
                    <rdf:Description rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#SendCapability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#Passing -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#Passing">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#PersonRecognition -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#PersonRecognition">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ComplexSocialCapability"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#PersonalProxemicZone -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#PersonalProxemicZone">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#ProxemicZone"/>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalCloseness">
        <rdfs:subClassOf rdf:resource="http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute"/>
        <rdfs:comment>The physical closeness of a physical object towards another from passing to intracorporeal.</rdfs:comment>
    </owl:Class>
    


    <!-- https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalTaskContext -->

    <owl:Class rdf:about="https://www.forsocialrobots.de/ontologies/sobots.owl#PhysicalTaskContext">
        <rdfs:subClassOf rdf:resource="https://www.forsocialrobots.de/ontologies/sobots.owl#TaskContext"/>
    </owl:Class>
    


