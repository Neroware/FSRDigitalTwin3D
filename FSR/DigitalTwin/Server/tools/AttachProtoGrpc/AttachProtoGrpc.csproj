<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Protos here -->
    <Protos>"./Protos/Base.proto,./Protos/DTO/AasModels.V3.proto,./Protos/DTO/AasApiModels.V3.proto,./Protos/Services/AdminShellRepositoryService.proto,./Protos/Services/SubmodelRepositoryService.proto,./Protos/Services/AssetAdministrationShellService.proto,./Protos/Services/SubmodelService.proto,./Protos/Services/DigitalTwinClientConnectionService.proto,./Protos/DTO/HRCModels.proto,./Protos/Services/HRCProcessSimulationService.proto"</Protos>
  </PropertyGroup>

  <Target Name="AttachToUnityWin" BeforeTargets="BeforeBuild" Condition=" '$(OS)' == 'Windows_NT' ">
    <Exec Command="if exist $(ProjectDir)\Protos\ del /F /Q $(ProjectDir)\Protos\" />
    <Exec Command="xcopy /E /Y $(SolutionDir)src\FSR.DigitalTwin.App.GRPC\Protos\ $(ProjectDir)\Protos\" />
    <Exec Command="powershell .\attach-proto-grpc.ps1 csharp --proto-tools $(SolutionDir)tools\Protoc\ --output $(SolutionDir)..\Client\Unity\FSR.DigitalTwin.Client.Unity\Assets\FSR\Scripts\GRPC.Generated\ --protos $(Protos)" />
  </Target>

  <Target Name="AttachToUnity" BeforeTargets="BeforeBuild" Condition=" '$(OS)' == 'UNIX' ">
    <Exec Command="mkdir -p $(ProjectDir)/Protos/" />
    <Exec Command="cp -r $(SolutionDir)src/FSR.DigitalTwin.App.GRPC/Protos/* $(ProjectDir)/Protos/" />
    <Exec Command="./attach-proto-grpc.sh csharp --proto-tools $(SolutionDir)tools/Protoc/ --output $(SolutionDir)../Client/Unity/FSR.DigitalTwin.Client.Unity/Assets/FSR/Scripts/GRPC.Generated/ --protos $(Protos)" />
  </Target>

</Project>
