--- !u!114 &6180775508720970974
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6180775508720970947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"CameraTop_frame\">\r\n  <sensor name=\"CameraTop\"
    type=\"camera\">\r\n    <update_rate>5.0</update_rate>\r\n    <camera name=\"camera_top\">\r\n     
    <horizontal_fov>1.0</horizontal_fov>\r\n      <image>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n        <format>R8G8B8</format>\r\n      </image>\r\n     
    <clip>\r\n        <near>0.3</near>\r\n        <far>500</far>\r\n      </clip>\r\n     
    <noise>\r\n        <type>gaussian</type>\r\n        <mean>0.0</mean>\r\n       
    <stddev>0.007</stddev>\r\n      </noise>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"camera_controller_top\">\r\n      <!-- <robotNamespace>/pepper</robotNamespace>
    -->\r\n      <alwaysOn>true</alwaysOn>\r\n      <updateRate>5.0</updateRate>\r\n     
    <cameraName>/pepper/camera/front</cameraName>\r\n      <imageTopicName>image_raw</imageTopicName>\r\n     
    <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n      <frameName>CameraTop_optical_frame</frameName>\r\n     
    <hackBaseline>0.07</hackBaseline>\r\n      <distortionK1>-0.0545211</distortionK1>\r\n     
    <distortionK2>0.06919734</distortionK2>\r\n      <distortionK3>-0.0241095</distortionK3>\r\n     
    <distortionT1>-0.0112245</distortionT1>\r\n      <distortionT2>0.0</distortionT2>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &6180775508720970975
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6180775508720970947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"CameraBottom_frame\">\r\n  <sensor name=\"CameraBottom\"
    type=\"camera\">\r\n    <update_rate>5.0</update_rate>\r\n    <camera name=\"camera_bottom\">\r\n     
    <horizontal_fov>1.0</horizontal_fov>\r\n      <image>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n        <format>R8G8B8</format>\r\n      </image>\r\n     
    <clip>\r\n        <near>0.05</near>\r\n        <far>500</far>\r\n      </clip>\r\n     
    <noise>\r\n        <type>gaussian</type>\r\n        <mean>0.0</mean>\r\n       
    <stddev>0.007</stddev>\r\n      </noise>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"camera_controller_bottom\">\r\n      <!-- <robotNamespace>/pepper</robotNamespace>
    -->\r\n      <alwaysOn>true</alwaysOn>\r\n      <updateRate>5.0</updateRate>\r\n     
    <cameraName>/pepper/camera/bottom</cameraName>\r\n      <imageTopicName>image_raw</imageTopicName>\r\n     
    <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n      <frameName>CameraBottom_optical_frame</frameName>\r\n     
    <hackBaseline>0.07</hackBaseline>\r\n      <distortionK1>-0.0648764</distortionK1>\r\n     
    <distortionK2>0.06125202</distortionK2>\r\n      <distortionK3>0.00382815</distortionK3>\r\n     
    <distortionT1>-0.00551104</distortionT1>\r\n      <distortionT2>0.0</distortionT2>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &6180775508720970968
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6180775508720970947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"CameraDepth_frame\">\r\n  <sensor name=\"CameraDepth_frame_sensor\"
    type=\"depth\">\r\n    <always_on>true</always_on>\r\n    <update_rate>30.0</update_rate>\r\n   
    <camera>\r\n      <horizontal_fov>1.0122909661567778</horizontal_fov>\r\n     
    <image>\r\n        <format>B8G8R8</format>\r\n        <width>320</width>\r\n       
    <height>240</height>\r\n      </image>\r\n      <clip>\r\n        <near>0.4</near>\r\n       
    <far>8.0</far>\r\n      </clip>\r\n    </camera>\r\n    <!-- TODO: Fork our own
    https://github.com/ros-simulation/gazebo_ros_pkgs/blob/kinetic-devel/gazebo_plugins/src/gazebo_ros_openni_kinect.cpp#L396\r\n       
    to have the depth image be the same format -->\r\n    <plugin filename=\"libgazebo_ros_camera.so\"
    name=\"CameraDepth_frame_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>30.0</updateRate>\r\n      <cameraName>pepper/camera</cameraName>\r\n     
    <imageTopicName>ir/image_raw</imageTopicName>\r\n      <cameraInfoTopicName>depth/camera_info</cameraInfoTopicName>\r\n     
    <depthImageTopicName>depth/image_raw</depthImageTopicName>\r\n      <pointCloudTopicName>depth/points</pointCloudTopicName>\r\n     
    <frameName>CameraDepth_optical_frame</frameName>\r\n      <pointCloudCutoff>0.4</pointCloudCutoff>\r\n     
    <pointCloudCutoffMax>8.0</pointCloudCutoffMax>\r\n      <useDepth16UC1Format>true</useDepth16UC1Format>\r\n     
    <distortionK1>0.0015006388343578579</distortionK1>\r\n      <distortionK2>-0.0391088434247705</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.002366597891470404</distortionT1>\r\n     
    <distortionT2>0.004792417377891919</distortionT2>\r\n      <CxPrime>0.0</CxPrime>\r\n     
    <Cx>166.86986665284704</Cx>\r\n      <Cy>126.63268197434216</Cy>\r\n      <focalLength>288.647970</focalLength>\r\n     
    <hackBaseline>0.0</hackBaseline>\r\n      <!-- <distortionK1>0.00000001</distortionK1>\r\n         
    <distortionK2>0.00000001</distortionK2>\r\n          <distortionK3>0.00000001</distortionK3>\r\n         
    <distortionT1>0.00000001</distortionT1>\r\n          <distortionT2>0.00000001</distortionT2>
    -->\r\n    </plugin>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &6180775508720970969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6180775508720970947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"SonarBack_frame\">\r\n  <sensor name=\"SonarBack\"
    type=\"ray\">\r\n    <pose>0 0 0 0 0 0</pose>\r\n    <update_rate>20</update_rate>\r\n   
    <visualize>false</visualize>\r\n    <ray>\r\n      <scan>\r\n        <horizontal>\r\n         
    <samples>5</samples>\r\n          <resolution>3</resolution>\r\n          <min_angle>-0.52</min_angle>\r\n         
    <max_angle>0.52</max_angle>\r\n        </horizontal>\r\n        <vertical>\r\n         
    <samples>5</samples>\r\n          <resolution>3</resolution>\r\n          <min_angle>-0.52</min_angle>\r\n         
    <max_angle>0.52</max_angle>\r\n        </vertical>\r\n      </scan>\r\n     
    <range>\r\n        <origin rpy=\"1.57 0.0 0.0 \" xyz=\"0.09 -0.155 -0.264\" />\r\n       
    <min>0.0</min>\r\n        <max>5.0</max>\r\n        <resolution>3</resolution>\r\n     
    </range>\r\n    </ray>\r\n    <plugin filename=\"libgazebo_ros_ray_sensor.so\"
    name=\"gazebo_ros_range\">\r\n      <robotNamespace>/pepper</robotNamespace>\r\n     
    <gaussianNoise>0.05</gaussianNoise>\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <updateRate>20</updateRate>\r\n      <topicName>sonar_back</topicName>\r\n     
    <frameName>SonarBack_frame</frameName>\r\n      <minRange>0.0</minRange>\r\n     
    <maxRange>5.0</maxRange>\r\n      <fov>1.05</fov>\r\n      <radiation>ultrasound</radiation>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
