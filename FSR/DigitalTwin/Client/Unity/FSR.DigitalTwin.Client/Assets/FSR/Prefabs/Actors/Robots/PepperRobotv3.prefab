  PluginText: "<gazebo>\r\n  <plugin filename=\"libgazebo_ros_p3d.so\" name=\"ground_truth\">\r\n   
    <frameName>world</frameName>\r\n    <body_name>base_footprint</body_name>\r\n   
    <topicName>/pepper/odom_groundtruth</topicName>\r\n    <updateRate>20.0</updateRate>\r\n 
    </plugin>\r\n</gazebo>"
--- !u!114 &6180775508720970965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6180775508720970947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<gazebo reference=\"lidar_front\">\r\n  <sensor name=\"gazebo_lidar_front\"
    type=\"ray\">\r\n    <visualize>true</visualize>\r\n    <update_rate>6.25</update_rate>\r\n   
    <plugin filename=\"libgazebo_ros_ray_sensor.so\" name=\"gazebo_lidar_front\">\r\n     
    <ros>\r\n        <remapping>~/out:=scan</remapping>\r\n      </ros>\r\n     
    <output_type>sensor_msgs/LaserScan</output_type>\r\n      <frame_name>lidar_front</frame_name>\r\n   
    </plugin>\r\n    <ray>\r\n      <scan>\r\n        <horizontal>\r\n          <samples>15</samples>\r\n         
    <resolution>1</resolution>\r\n          <min_angle>-0.5235987755982988</min_angle>\r\n         
    <max_angle>0.5235987755982988</max_angle>\r\n        </horizontal>\r\n      </scan>\r\n     
    <range>\r\n        <min>0.3</min>\r\n        <max>7.0</max>\r\n        <resolution>0.005</resolution>\r\n     
    </range>\r\n    </ray>\r\n  </sensor>\r\n</gazebo>"
